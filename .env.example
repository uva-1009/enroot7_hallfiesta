# Copy to .env.local for local testing. On Vercel, add each one under Settings > Environment Variables.
# Never commit real values. .env.local is ignored by git.

# Supabase: Project Settings > API (or Data API). The service role key is SECRET: server only, never NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# PIN for the /staff facilitator page. Use something longer than 4 digits, e.g. a short phrase.
STAFF_PIN=

# Telegram: from @BotFather. NEXT_PUBLIC_BOT_USERNAME is the bot's username without the @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_BOT_USERNAME=

# Any long random string. Vercel sends it to the reminder cron job automatically.
CRON_SECRET=
